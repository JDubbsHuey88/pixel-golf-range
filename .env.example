# Bearer token required on all mutating /api/* routes.
API_TOKEN=change-me-long-random-string

# Same value, exposed to the browser so the UI can call the mutation routes.
# (The app is Tailscale-gated; the UI has no login of its own.)
NEXT_PUBLIC_API_TOKEN=change-me-long-random-string

# Used by the MCP server to reach the app.
TRANSFORM_API_URL=http://localhost:3000
